# Required interim credential for authenticated service-to-service requests.
# Replace this value with a randomly generated secret of at least 32 characters.
INTERNAL_SERVICE_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Local Compose credential and pool settings for Auth-owned PostgreSQL.
AUTH_DB_PASSWORD=auth-dev-only
AUTH_DB_MAX_OPEN_CONNS=25
AUTH_DB_MAX_IDLE_CONNS=5
AUTH_DB_CONN_MAX_LIFETIME=30m
AUTH_DB_CONN_MAX_IDLE_TIME=5m
AUTH_DB_CONNECT_TIMEOUT=10s

# Timeout for Chat's authenticated membership reads from Groups.
GROUPS_SERVICE_TIMEOUT=3s

# Local Compose credential and pool settings for Chat-owned PostgreSQL.
CHAT_DB_PASSWORD=chat-dev-only
CHAT_DB_MAX_OPEN_CONNS=25
CHAT_DB_MAX_IDLE_CONNS=5
CHAT_DB_CONN_MAX_LIFETIME=30m
CHAT_DB_CONN_MAX_IDLE_TIME=5m
CHAT_DB_CONNECT_TIMEOUT=10s

# Internal synchronous read contracts used during database separation.
USERS_SERVICE_TIMEOUT=3s
POSTS_SERVICE_TIMEOUT=3s

# Local Compose credential and pool settings for Posts-owned PostgreSQL.
POSTS_DB_PASSWORD=posts-dev-only
POSTS_DB_MAX_OPEN_CONNS=25
POSTS_DB_MAX_IDLE_CONNS=5
POSTS_DB_CONN_MAX_LIFETIME=30m
POSTS_DB_CONN_MAX_IDLE_TIME=5m
POSTS_DB_CONNECT_TIMEOUT=10s

# Local Compose credential and pool settings for Groups-owned PostgreSQL.
GROUPS_DB_PASSWORD=groups-dev-only
GROUPS_DB_MAX_OPEN_CONNS=25
GROUPS_DB_MAX_IDLE_CONNS=5
GROUPS_DB_CONN_MAX_LIFETIME=30m
GROUPS_DB_CONN_MAX_IDLE_TIME=5m
GROUPS_DB_CONNECT_TIMEOUT=10s

# Exact browser origins permitted to open Chat and Notification WebSockets.
# In production, replace these with the public HTTPS application origin only.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Gateway protection. Rate-limit state is shared by all Gateway replicas in
# Redis; a replica-local token bucket is used only during a Redis outage.
GATEWAY_RATE_LIMIT_RPS=20
GATEWAY_RATE_LIMIT_BURST=40
GATEWAY_MAX_BODY_BYTES=12582912

# Shared ephemeral coordination for Gateway rate limits, Chat presence, and
# Chat/Notification WebSocket fan-out. Compose supplies its private Redis host
# by default. Production should use a managed TLS endpoint and secret manager.
REDIS_URL=redis://redis:6379/0
REDIS_NAMESPACE=social-network
REDIS_OPERATION_TIMEOUT=2s
REDIS_PRESENCE_TTL=45s
REDIS_PRESENCE_REFRESH=15s

# Local Compose credential for the service-owned Notifications PostgreSQL
# database. Production must supply DATABASE_URL through a secrets manager.
# If this password contains URL-reserved characters, URL-encode it before use.
NOTIFICATIONS_DB_PASSWORD=notifications-dev-only
NOTIFICATIONS_DB_MAX_OPEN_CONNS=25
NOTIFICATIONS_DB_MAX_IDLE_CONNS=5
NOTIFICATIONS_DB_CONN_MAX_LIFETIME=30m
NOTIFICATIONS_DB_CONN_MAX_IDLE_TIME=5m
NOTIFICATIONS_DB_CONNECT_TIMEOUT=10s

# Local S3-compatible media storage. In production these are supplied by the
# object-storage provider or secret manager, and PUBLIC_BASE_URL should be the
# application media route or CDN origin.
OBJECT_STORAGE_ACCESS_KEY=socialnetwork
OBJECT_STORAGE_SECRET_KEY=socialnetwork-dev-only
OBJECT_STORAGE_BUCKET=social-network-media
OBJECT_STORAGE_ENDPOINT=media:9000
OBJECT_STORAGE_USE_TLS=false
OBJECT_STORAGE_PUBLIC_BASE_URL=/media/social-network-media
